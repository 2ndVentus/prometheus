{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MarketData": {
    "Yahoo": {
      "BaseUrl": "https://query1.finance.yahoo.com/",
      "Interval": "15m",
      "Range": "1mo",
      "MaxRetryAttempts": 2,
      "AttemptTimeout": "00:00:04",
      "TotalRequestTimeout": "00:00:10"
    },
    "Cache": {
      "Duration": "00:05:00"
    }
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "Window": "00:01:00"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  }
}
